<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>

  <groupId>com.smartconnect</groupId>
  <artifactId>smartconnect-parent</artifactId>
  <version>0.1.0-SNAPSHOT</version>
  <packaging>pom</packaging>

  <name>SmartConnect Parent</name>
  <description>Reactor/parent POM for the SmartConnect backend: shared BOM versions and build config for libs/commons and every service.</description>

  <properties>
    <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
    <java.version>17</java.version>
    <maven.compiler.release>17</maven.compiler.release>
    <!--
      We don't inherit from spring-boot-starter-parent (this is a plain multi-module reactor
      with the Boot/Cloud BOMs imported instead), so we don't get its default -parameters
      compiler flag for free. Without it, reflection-based parameter name resolution (e.g.
      @PathVariable String id with no explicit name) fails at runtime with "Name for argument
      of type [...] not specified" even though everything compiles fine - only bites at
      request time, so keep this on for every module.
    -->
    <maven.compiler.parameters>true</maven.compiler.parameters>
    <spring-boot.version>3.3.4</spring-boot.version>
    <spring-cloud.version>2023.0.3</spring-cloud.version>
    <!-- Newer than Boot 3.3's 1.19.8, which can't talk to Docker Engine 29+ -->
    <testcontainers.version>1.21.3</testcontainers.version>
    <testcontainers-keycloak.version>3.9.1</testcontainers-keycloak.version>
  </properties>

  <modules>
    <module>libs/commons</module>
    <module>services/api-gateway</module>
    <module>services/user-service</module>
    <module>services/notification-service</module>
    <!-- new-service:platform (scripts/new-service.sh adds platform modules above this line) -->
  </modules>

  <!--
    Example apps under examples/ build only with -Pexamples (Docker builds always pass it), so
    the default reactor - and CI - stays platform-only.
  -->
  <profiles>
    <profile>
      <id>examples</id>
      <modules>
        <module>examples/demo-app/demo-service</module>
        <!-- new-service:examples (scripts/new-service.sh adds example modules above this line) -->
      </modules>
    </profile>
  </profiles>

  <dependencyManagement>
    <dependencies>
      <!-- Imported first so it wins over the Testcontainers version in Boot's BOM -->
      <dependency>
        <groupId>org.testcontainers</groupId>
        <artifactId>testcontainers-bom</artifactId>
        <version>${testcontainers.version}</version>
        <type>pom</type>
        <scope>import</scope>
      </dependency>
      <dependency>
        <groupId>org.springframework.boot</groupId>
        <artifactId>spring-boot-dependencies</artifactId>
        <version>${spring-boot.version}</version>
        <type>pom</type>
        <scope>import</scope>
      </dependency>
      <dependency>
        <groupId>org.springframework.cloud</groupId>
        <artifactId>spring-cloud-dependencies</artifactId>
        <version>${spring-cloud.version}</version>
        <type>pom</type>
        <scope>import</scope>
      </dependency>
      <dependency>
        <groupId>com.smartconnect</groupId>
        <artifactId>smartconnect-commons</artifactId>
        <version>${project.version}</version>
      </dependency>
      <dependency>
        <groupId>com.github.dasniko</groupId>
        <artifactId>testcontainers-keycloak</artifactId>
        <version>${testcontainers-keycloak.version}</version>
      </dependency>
    </dependencies>
  </dependencyManagement>

  <build>
    <!--
      *Test classes are unit tests (surefire, fast, no Docker). *IT classes are integration tests
      against real containers (Testcontainers) and run in `mvn verify` via failsafe; skip them in
      a quick local loop with -DskipITs. CI runs everything.
    -->
    <plugins>
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-failsafe-plugin</artifactId>
        <executions>
          <execution>
            <goals>
              <goal>integration-test</goal>
              <goal>verify</goal>
            </goals>
          </execution>
        </executions>
      </plugin>
    </plugins>
    <pluginManagement>
      <plugins>
        <plugin>
          <groupId>org.apache.maven.plugins</groupId>
          <artifactId>maven-failsafe-plugin</artifactId>
          <version>3.2.5</version>
          <configuration>
            <!-- Run against the jar's classes, not the repackaged Boot jar -->
            <classesDirectory>${project.build.outputDirectory}</classesDirectory>
            <systemPropertyVariables>
              <!-- Docker Engine 29+ rejects the older API version docker-java asks for by default -->
              <api.version>1.44</api.version>
            </systemPropertyVariables>
          </configuration>
        </plugin>
        <plugin>
          <groupId>org.apache.maven.plugins</groupId>
          <artifactId>maven-surefire-plugin</artifactId>
          <version>3.2.5</version>
        </plugin>
        <plugin>
          <groupId>org.springframework.boot</groupId>
          <artifactId>spring-boot-maven-plugin</artifactId>
          <version>${spring-boot.version}</version>
          <executions>
            <execution>
              <goals>
                <goal>repackage</goal>
              </goals>
            </execution>
          </executions>
        </plugin>
      </plugins>
    </pluginManagement>
  </build>

</project>
