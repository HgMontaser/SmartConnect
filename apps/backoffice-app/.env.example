# Keycloak server base URL, reachable from the browser (not the docker network name)
VITE_KEYCLOAK_URL=http://localhost:8080

# api-gateway base URL for REST calls (this app only ever talks to the gateway,
# never to user-service directly)
VITE_GATEWAY_HTTP_URL=http://localhost:8090

# api-gateway WebSocket base URL for the live user-events bridge
VITE_GATEWAY_WS_URL=ws://localhost:8090
