# Keycloak server base URL, reachable from the browser (not the docker network name)
VITE_KEYCLOAK_URL=http://localhost:8080

# Where to send the browser after the SSO handshake completes.
# No tokens are appended here — the business app relies on Keycloak's SSO session cookie.
VITE_BUSINESS_APP_HOME_URL=http://localhost:5174/
