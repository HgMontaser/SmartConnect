<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>

  <parent>
    <groupId>com.smartconnect</groupId>
    <artifactId>smartconnect-parent</artifactId>
    <version>0.1.0-SNAPSHOT</version>
    <relativePath>../../pom.xml</relativePath>
  </parent>

  <artifactId>smartconnect-commons</artifactId>
  <packaging>jar</packaging>
  <name>SmartConnect Commons</name>
  <description>
    Shared library for every SmartConnect backend service: resource-server security config,
    correlation-id propagation (servlet + reactive), Kafka user-events DTOs, standard error
    response mapping, and common Actuator/Micrometer tags. Plain library only - never a
    runtime service, never gets its own port.
  </description>

  <dependencies>
    <!-- Core -->
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter</artifactId>
    </dependency>
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-autoconfigure</artifactId>
    </dependency>
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-actuator</artifactId>
    </dependency>

    <!-- Resource server / JWT - stack agnostic, safe to be a hard dependency -->
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-security</artifactId>
    </dependency>
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-oauth2-resource-server</artifactId>
    </dependency>

    <!--
      Web stack support is optional at the Maven level: commons compiles against both the
      servlet (Spring MVC) and reactive (WebFlux) APIs, but marking these optional=true means
      a consuming service (e.g. api-gateway on WebFlux, user-service on Spring MVC) must pull
      in the stack it actually uses. This avoids ever having both Tomcat and Netty/Reactor
      wired into the same service by accident. @ConditionalOnClass guards in the auto-config
      classes ensure only the matching stack's beans activate at runtime.
    -->
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-web</artifactId>
      <optional>true</optional>
    </dependency>
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-webflux</artifactId>
      <optional>true</optional>
    </dependency>

    <!-- Kafka DTOs + correlation-id propagation helpers - optional, only services touching Kafka need it -->
    <dependency>
      <groupId>org.springframework.kafka</groupId>
      <artifactId>spring-kafka</artifactId>
      <optional>true</optional>
    </dependency>

    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-test</artifactId>
      <scope>test</scope>
    </dependency>
    <dependency>
      <groupId>io.projectreactor</groupId>
      <artifactId>reactor-test</artifactId>
      <scope>test</scope>
    </dependency>
  </dependencies>

</project>
