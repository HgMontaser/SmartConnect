{
  "realm": "smartconnect",
  "enabled": true,
  "sslRequired": "none",
  "registrationAllowed": false,
  "accessTokenLifespan": 300,
  "loginTheme": "smartconnect",
  "roles": {
    "realm": [
      { "name": "admin", "description": "SmartConnect administrator" },
      { "name": "user", "description": "SmartConnect standard user" }
    ]
  },
  "clients": [
    {
      "clientId": "gateway",
      "name": "api-gateway resource server",
      "protocol": "openid-connect",
      "publicClient": false,
      "bearerOnly": true,
      "standardFlowEnabled": false,
      "directAccessGrantsEnabled": false,
      "serviceAccountsEnabled": false,
      "enabled": true
    },
    {
      "clientId": "login-app",
      "name": "login-app",
      "protocol": "openid-connect",
      "publicClient": true,
      "standardFlowEnabled": true,
      "directAccessGrantsEnabled": true,
      "implicitFlowEnabled": false,
      "serviceAccountsEnabled": false,
      "attributes": {
        "pkce.code.challenge.method": "S256"
      },
      "redirectUris": [
        "http://login.smartconnect.local:5173/*",
        "http://localhost:5173/*",
        "http://login.51.170.140.178.nip.io/*"
      ],
      "webOrigins": [
        "http://login.smartconnect.local:5173",
        "http://localhost:5173",
        "http://login.51.170.140.178.nip.io"
      ],
      "enabled": true
    },
    {
      "clientId": "backoffice-app",
      "name": "backoffice-app",
      "protocol": "openid-connect",
      "publicClient": true,
      "standardFlowEnabled": true,
      "directAccessGrantsEnabled": false,
      "implicitFlowEnabled": false,
      "serviceAccountsEnabled": false,
      "attributes": {
        "pkce.code.challenge.method": "S256"
      },
      "redirectUris": [
        "http://backoffice.smartconnect.local:5174/*",
        "http://localhost:5174/*",
        "http://app.51.170.140.178.nip.io/*"
      ],
      "webOrigins": [
        "http://backoffice.smartconnect.local:5174",
        "http://localhost:5174",
        "http://app.51.170.140.178.nip.io"
      ],
      "enabled": true
    }
  ],
  "users": [
    {
      "username": "admin.seed",
      "enabled": true,
      "emailVerified": true,
      "email": "admin.seed@smartconnect.local",
      "firstName": "Seed",
      "lastName": "Admin",
      "credentials": [
        {
          "type": "password",
