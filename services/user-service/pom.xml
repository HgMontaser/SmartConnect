<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>

  <parent>
    <groupId>com.smartconnect</groupId>
    <artifactId>smartconnect-parent</artifactId>
    <version>0.1.0-SNAPSHOT</version>
    <relativePath>../../pom.xml</relativePath>
  </parent>

  <artifactId>user-service</artifactId>
  <packaging>jar</packaging>
  <name>SmartConnect User Service</name>
  <description>
    Servlet-stack (Spring MVC) resource server. Owns no database - Keycloak is the source of
    truth for users, this service is a thin REST CRUD facade over the Keycloak Admin REST API.
    Publishes UserEvent to the "user-events" Kafka topic on every mutation. Only reachable via
    api-gateway in normal operation; validates JWTs independently regardless (defense in depth,
    per phase1 "every backend service is its own resource server").
  </description>

  <properties>
    <!-- Pinned to match the Keycloak server image version (quay.io/keycloak/keycloak:25.0) -->
    <keycloak-admin-client.version>25.0.6</keycloak-admin-client.version>
  </properties>

  <dependencies>
    <dependency>
      <groupId>com.smartconnect</groupId>
      <artifactId>smartconnect-commons</artifactId>
    </dependency>

    <!-- Servlet stack: REST CRUD controller -->
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-web</artifactId>
    </dependency>
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-validation</artifactId>
    </dependency>

    <!-- Config from Vault at boot, fail fast if unreachable -->
    <dependency>
      <groupId>org.springframework.cloud</groupId>
      <artifactId>spring-cloud-starter-vault-config</artifactId>
    </dependency>

    <!-- Publishes UserEvent to the user-events topic -->
    <dependency>
      <groupId>org.springframework.kafka</groupId>
      <artifactId>spring-kafka</artifactId>
    </dependency>

    <!-- Keycloak Admin REST API client - this service's only "datastore" -->
    <dependency>
      <groupId>org.keycloak</groupId>
      <artifactId>keycloak-admin-client</artifactId>
      <version>${keycloak-admin-client.version}</version>
    </dependency>

    <!-- Ship metrics to the Elastic stack -->
    <dependency>
      <groupId>io.micrometer</groupId>
      <artifactId>micrometer-registry-elastic</artifactId>
    </dependency>

    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-test</artifactId>
      <scope>test</scope>
    </dependency>
    <dependency>
      <groupId>org.springframework.kafka</groupId>
      <artifactId>spring-kafka-test</artifactId>
      <scope>test</scope>
    </dependency>
    <dependency>
      <groupId>org.springframework.security</groupId>
      <artifactId>spring-security-test</artifactId>
      <scope>test</scope>
    </dependency>
  </dependencies>

  <build>
    <plugins>
      <plugin>
        <groupId>org.springframework.boot</groupId>
        <artifactId>spring-boot-maven-plugin</artifactId>
      </plugin>
    </plugins>
  </build>

</project>
